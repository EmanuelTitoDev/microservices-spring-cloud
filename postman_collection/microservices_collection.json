            "body": {
              "mode": "raw",
              "raw": "{\n    \"items\": [\n        {\n            \"productCode\": \"{{product_code}}\",\n            \"quantity\": -5\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/cart",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "cart"
