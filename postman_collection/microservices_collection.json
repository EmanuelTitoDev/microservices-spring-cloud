          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gateway_url}}/api/cart",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "cart"
              ]
            }
          }
        },
        {
          "name": "Get Cart By ID",
